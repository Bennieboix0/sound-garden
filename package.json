{
  "name": "sound-garden",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sheet music reader for working musicians. Offline, local-first, foot-pedal driven.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "icons": "python3 scripts/generate_icons.py public/icons",
    "test:rls": "node supabase/tests/rls.test.mjs",
    "test:merge": "esbuild src/sync/engine.ts --bundle --format=esm --outfile=dist-test/engine.mjs --log-level=warning && node supabase/tests/merge.test.mjs",
    "test": "npm run test:rls && npm run test:ensembles && npm run test:merge",
    "test:ensembles": "node supabase/tests/ensembles.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.112.4",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "fflate": "^0.8.2",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  }
}
