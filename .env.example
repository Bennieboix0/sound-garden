# Sound Garden is fully functional with none of these set.
# Without them the app is local-only, and the Supabase client is not even
# included in the bundle.
#
# Copy to .env.local and fill in to enable optional sync.

# Compile sync out entirely. Any other value (or absent) leaves it in.
# VITE_SYNC_ENABLED=false

# From your Supabase project: Settings -> API.
# The anon key is a public client key and is safe in a browser bundle; row
# level security is what actually protects the data.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
